// Prisma 7 (Rust 엔진 없는 클라이언트 + driver adapter). DB 주소는 prisma.config.ts에서 읽음.
// DB는 Postgres (Vercel + Neon 무료 티어 기준). 런타임 연결은 src/lib/db.ts 의 adapter-pg.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 커플 (서비스를 같이 쓰는 한 팀). 모든 데이터가 여기에 묶임 (Category·Event·Expense·Note 의 coupleId, 나머지는 부모를 따라감).
/// 결혼식 정보도 여기에. 이 행이 있으면 '시작하기'를 마친 것
model Couple {
  id         String     @id @default(cuid())
  /// 결혼식 날짜. 추천 일정 계산 기준
  date       DateTime?
  place      String?
  /// 우리 둘 이름 (비밀번호 잠금 모드에서 '이 기기는 누구' 목록)
  names      String[]   @default([])
  /// 배우자 초대 링크 /join/[inviteCode]. 다시 만들면 예전 링크는 막힘
  inviteCode String     @unique
  users      User[]
  categories Category[]
  events     Event[]
  expenses   Expense[]
  notes      Note[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

/// (옛 결혼식 정보, 한 줄) 지금은 쓰지 않음. scripts/migrate-couples.ts 가 첫 커플로 옮김 — 다음 배포에서 지움
model Wedding {
  id        Int       @id @default(1)
  /// 결혼식 날짜. 추천 일정 계산 기준
  date      DateTime?
  place     String?
  /// 우리 둘 이름. 비밀번호로 잠글 때 '이 기기는 누구'를 고르는 목록
  names     String[]  @default([])
  updatedAt DateTime  @updatedAt
}

/// 이벤트 카테고리. 처음엔 기본 6개, 설정에서 추가·이름·색 변경. '기타'는 지울 수 없음
model Category {
  id        String   @id @default(cuid())
  /// (옮기는 동안만 비어 있을 수 있음)
  couple    Couple?  @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  coupleId  String?
  name      String
  color     String
  /// 이 카테고리에 쓸 예산(원). 0 = 안 정함
  budget    Int      @default(0)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([coupleId, name])
  @@index([coupleId])
}

/// 준비 이벤트 (20개 기본 + 직접 추가)
model Event {
  id          String    @id @default(cuid())
  couple      Couple?   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  coupleId    String?
  order       Int
  title       String
  /// Category.name (이름을 바꾸면 같이 바꿈)
  category    String    @default("기타")
  date        DateTime?
  /// 'HH:MM'. 비어 있으면 하루 종일
  startTime   String?
  endTime     String?
  place       String?
  memo        String?
  /// 템플릿 안내 (하객 수 → 웨딩홀·청첩장)
  hint        String?
  done        Boolean   @default(false)
  doneAt      DateTime?
  doneBy      String?
  /// 기본 20개 이벤트의 키 (s01…). 커플마다 하나씩이라 (coupleId, templateKey) 로 유일
  templateKey String?
  tasks       Task[]
  dues        Due[]
  photos      Photo[]
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([coupleId, templateKey])
  @@index([coupleId, order])
}

/// 이벤트 안 할 일
model Task {
  id        String    @id @default(cuid())
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  /// 상견례 / 드레스 피팅 / 행정·혜택 …
  section   String?
  content   String
  date      DateTime?
  done      Boolean   @default(false)
  doneAt    DateTime?
  doneBy    String?
  createdBy String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([eventId])
}

/// (옛 결제) 지금은 쓰지 않음. 결제·지출이 Expense 하나로 합쳐짐 (scripts/merge-dues.ts 가 배포할 때 옮기고 지움).
/// 옮기기 전에 db push 가 테이블을 지우지 않게 남겨 둠 — 운영에서 비어 있는 걸 확인한 뒤 다음 배포에서 지움
model Due {
  id        String    @id @default(cuid())
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  /// 잔금, 계약금 …
  title     String
  date      DateTime
  /// 원. 비어 있으면 날짜만 챙기는 결제
  amount    Int?
  memo      String?
  done      Boolean   @default(false)
  doneAt    DateTime?
  doneBy    String?
  createdAt DateTime  @default(now())

  @@index([eventId])
}

/// 카카오 로그인 사용자. 커플 하나에 속함 (처음엔 없음 → 시작하기 또는 초대 링크로 합류)
model User {
  id            String    @id @default(cuid())
  kakaoId       String    @unique
  nickname      String?
  /// 앱에서 쓰는 이름. '체크한 사람'으로 남음
  name          String
  couple        Couple?   @relation(fields: [coupleId], references: [id], onDelete: SetNull)
  coupleId      String?
  /// 커플 안에서: OWNER(만든 사람, 멤버 내보내기·초대 링크 바꾸기) | MEMBER
  role          String    @default("MEMBER")
  /// (옛 승인 방식) 지금은 늘 APPROVED. 커플 합류는 초대 링크로
  status        String    @default("APPROVED")
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?
  /// 앱을 쓴 날 수 (하루에 한 번만 셈, 홈을 열 때) — 후원 안내를 열심히 쓰는 사람에게만 띄우려고
  activeDays    Int       @default(0)
  /// 마지막으로 센 날 'YYYY-MM-DD' (KST)
  lastActiveDay String?
  /// 후원 안내 '다시 보지 않기'
  supportOptOut Boolean   @default(false)
  /// 후원 안내를 이때까지 안 띄움 ('나중에' 30일, 후원 버튼 누르면 180일)
  supportSnooze DateTime?
}

/// 이벤트 사진. 브라우저에서 줄여서 올리고(긴 쪽 1600px) 작은 미리보기(400px)도 같이 저장.
/// 파일은 Vercel Blob(비공개)에 두고 url 만 저장. Blob 을 연결하기 전·옮기기 전 사진은 data/thumb 에 바이트로
model Photo {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  mime      String
  url       String?
  thumbUrl  String?
  data      Bytes?
  thumb     Bytes?
  width     Int
  height    Int
  createdBy String?
  createdAt DateTime @default(now())

  @@index([eventId])
}

/// 결제·지출 (돈 한 건). paid = 냈어요(예산 '지출'), 아니면 낼 예정(예산 '결제 예정', 캘린더에 결제로 보임).
/// 이벤트에 묶지 않아도 됨 (이벤트를 지워도 기록은 남고 연결만 끊김)
model Expense {
  id        String    @id @default(cuid())
  couple    Couple?   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  coupleId  String?
  title     String
  /// 원. 금액을 아직 모르면 비움 (낼 예정일 때. 화면에서 낸 돈은 금액을 받음)
  amount    Int?
  /// 냈으면 결제일, 아니면 낼 날 (그날 09:00 KST 로 저장, src/lib/dates.ts)
  date      DateTime
  paid      Boolean   @default(true)
  /// '결제 완료'를 누른 때·사람
  paidAt    DateTime?
  paidBy    String?
  /// Category.name (이름을 바꾸면 같이 바꿈)
  category  String    @default("기타")
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId   String?
  memo      String?
  receipts  Receipt[]
  createdBy String?
  createdAt DateTime  @default(now())
  /// 내용·증빙을 바꿀 때마다
  updatedAt DateTime  @updatedAt
  updatedBy String?

  @@index([coupleId, date])
  @@index([eventId])
}

/// 지출 첨부: 증빙 이미지(영수증·계약서 사진, 줄여서 저장 + 미리보기) 또는 파일(PDF·한글·엑셀 등 5MB 까지, 그대로 저장).
/// 저장 방식은 Photo 와 같음 (Blob 비공개, 없으면 DB 바이트). 파일은 2MB 씩 나눠 받아 data 에 이어 붙인 뒤 ready
model Receipt {
  id        String   @id @default(cuid())
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String
  mime      String
  url       String?
  thumbUrl  String?
  data      Bytes?
  thumb     Bytes?
  /// 이미지만 (파일은 0)
  width     Int
  height    Int
  /// 파일만: 올린 파일 이름·크기(바이트)
  name      String?
  size      Int?
  /// 파일을 나눠 올리는 중이면 false (화면에 안 보임)
  ready     Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())

  @@index([expenseId])
}

/// 메모 (이벤트와 따로 쓰는 자유 메모). 본문은 Tiptap 문서 JSON: 글(제목·목록·체크리스트 등) 사이에 손그림 블록이 들어감.
/// 저장할 때 서버에서 스키마로 검사하고(src/lib/note-doc.ts) 목록용 글(text)과 그림 수(drawings)를 같이 저장
model Note {
  id        String   @id @default(cuid())
  couple    Couple?  @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  coupleId  String?
  /// 비어 있으면 목록에서 본문 첫 줄을 제목처럼 보여 줌
  title     String   @default("")
  content   Json
  /// 본문 글만 뽑은 것 (목록 미리보기)
  text      String   @default("")
  drawings  Int      @default(0)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([coupleId, updatedAt])
}
