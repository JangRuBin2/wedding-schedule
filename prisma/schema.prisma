// Prisma 7 (Rust 엔진 없는 클라이언트 + driver adapter). DB 주소는 prisma.config.ts에서 읽음.
// DB는 Postgres (Vercel + Neon 무료 티어 기준). 런타임 연결은 src/lib/db.ts 의 adapter-pg.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 결혼식 정보 (레코드 하나). 이 행이 있으면 '시작하기'를 마친 것
model Wedding {
  id        Int       @id @default(1)
  /// 결혼식 날짜. 추천 일정 계산 기준
  date      DateTime?
  place     String?
  /// 우리 둘 이름. 비밀번호로 잠글 때 '이 기기는 누구'를 고르는 목록
  names     String[]  @default([])
  updatedAt DateTime  @updatedAt
}

/// 준비 이벤트 (20개 기본 + 직접 추가)
model Event {
  id          String    @id @default(cuid())
  order       Int
  title       String
  /// 예식 | 스드메 | 예물·예단 | 신혼여행 | 신혼집 | 기타
  category    String    @default("기타")
  date        DateTime?
  memo        String?
  /// 템플릿 안내 (하객 수 → 웨딩홀·청첩장)
  hint        String?
  done        Boolean   @default(false)
  doneAt      DateTime?
  doneBy      String?
  templateKey String?   @unique
  tasks       Task[]
  dues        Due[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// 이벤트 안 할 일
model Task {
  id        String    @id @default(cuid())
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  /// 상견례 / 드레스 피팅 / 행정·혜택 …
  section   String?
  content   String
  date      DateTime?
  done      Boolean   @default(false)
  doneAt    DateTime?
  doneBy    String?
  createdBy String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([eventId])
}

/// 돈 낼 날 (계약금·중도금·잔금). 금액은 저장하지 않아요
model Due {
  id        String    @id @default(cuid())
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  /// 잔금, 계약금 …
  title     String
  date      DateTime
  memo      String?
  done      Boolean   @default(false)
  doneAt    DateTime?
  doneBy    String?
  createdAt DateTime  @default(now())

  @@index([eventId])
}

/// 카카오 로그인 사용자
model User {
  id          String    @id @default(cuid())
  kakaoId     String    @unique
  nickname    String?
  /// 앱에서 쓰는 이름. '체크한 사람'으로 남음
  name        String
  /// OWNER | MEMBER
  role        String    @default("MEMBER")
  /// APPROVED | PENDING | REJECTED
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
}
